### Job Comments: list for an Enquiry, oldest first.
POST {{baseUrl}}/api/v2/method/frappe.client.get_list
Authorization: token {{token}}
Content-Type: application/json

{
	"doctype": "Job Comments",
	"filters": [
		[ "job_type", "=", "Enquiry" ],
		[ "job_id", "=", "ENQ699" ]
	],
	"order_by": "creation asc",
	"fields": [
		"name",
		"creation",
		"owner",
		"comment",
		"mode",
		"parent_comment"
	]
}



### Job Comments: add a comment to an Enquiry (existing comments are not sent).
POST {{baseUrl}}/api/v2/document/Job Comments
Authorization: token {{token}}
Content-Type: application/json

{
    "job_type": "Enquiry",
    "job_id": "ENQ699",
    "comment": "Comment-2"
}


