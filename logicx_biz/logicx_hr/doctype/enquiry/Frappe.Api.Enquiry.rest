### Enquiry: Open / Un-assigned
POST {{baseUrl}}/api/v2/method/frappe.client.get_list
Authorization: token {{token}}
Content-Type: application/json

{
	"doctype": "Enquiry",
	"filters": [
		[ "assigned_to_employee", "is", "not set" ],
		[ "status", "not in", ["Won","Lost"] ]
	],
	"order_by": "creation desc",
	"fields": [
		"name",
		"date",
		"creation",
		"status",
		"group",
		"customer.customer_name",
		"user_employee.employee_name as user_employee_name",
		"enquiry_details"
	]
}




### Group(List-In) aggregates
POST {{baseUrl}}/api/v2/method/frappe.client.get_list
Authorization: token {{token}}
Content-Type: application/json

{
	"doctype": "Enquiry",
	"fields": [
			"group",
			{"COUNT": "name", "as": "group_count"}
		],
	"filters": [
			[ "assigned_to_employee", "=", "HR-EMP-00006" ],
			[ "status", "not in", ["Won","Lost"] ]
		],
	"group_by": "group",
	"order_by": "group asc"
}

