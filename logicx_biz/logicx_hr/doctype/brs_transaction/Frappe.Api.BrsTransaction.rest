### Bulk insert: data that ends too soon -- refused, nothing written.
	# Row 1 is the last posted transaction, so the append point is found; but the data then
	# ends with only 1 confirmation against a chain that has more behind it, below
	# MIN_BACKWARD_MATCHES_LIMIT of 2:
	# "The data confirms only 1 of ...'s posted transactions before it ends, and 2 have to
	#  be confirmed."
	# Sending one row further back (as the call above does) is enough.
POST {{baseUrl}}/api/v2/method/logicx_biz.logicx_hr.doctype.brs_transaction.brs_transaction.bulk_insert
Authorization: token {{token}}
Content-Type: application/json

{
  "data": [
    {
      "bank_account": "HDFC Bank 4980 - HDFC",
      "date": "2026-04-06",
      "description": "Cheque 104513 - Electricity",
      "reference_number": "104513",
      "withdrawal": 2500.0,
      "deposit": 0.0,
      "closing_balance": 56500.0
    },
    {
      "bank_account": "HDFC Bank 4980 - HDFC",
      "date": "2026-04-07",
      "description": "NEFT from customer 4",
      "reference_number": "N091260401235001",
      "withdrawal": 0.0,
      "deposit": 1500.0,
      "closing_balance": 58000.0
    }
  ]
}



### Bulk insert: a statement that disagrees with what is posted -- refused, nothing written.
	# Row 3 is the last posted transaction (BRSTXN7), so the append point is found and the
	# walk sets off: row 3 = BRSTXN7, row 2 = BRSTXN6, and then row 1, whose Deposit has been
	# changed from 3000 to 3500, meets BRSTXN5:
	# "Row 1 does not match BRSTXN5 ... Deposit, Closing Balance differ."
POST {{baseUrl}}/api/v2/method/logicx_biz.logicx_hr.doctype.brs_transaction.brs_transaction.bulk_insert
Authorization: token {{token}}
Content-Type: application/json

{
  "data": [
