      "reference_number": "104512",
      "withdrawal": 5000.0,
      "deposit": 0.0,
      "closing_balance": 45000.0
    },
    {
      "bank_account": "HDFC Bank 4980 - HDFC",
      "date": "2026-04-01",
      "description": "NEFT from customer",
      "reference_number": "N091260401234567",
      "withdrawal": 0.0,
      "deposit": 10000.0,
      "closing_balance": 55000.0
    },
    {
      "bank_account": "HDFC Bank 4980 - HDFC",
      "date": "2026-04-02",
      "description": "NEFT from customer 1",
      "reference_number": "N091260401234568",
      "withdrawal": 1000.0,
      "deposit": 0.0,
      "closing_balance": 54000.0
