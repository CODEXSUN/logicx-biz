# API One / API One Log -- VS Code REST Client examples
#
# Set in your REST Client environment (settings.json -> "rest-client.environmentVariables"):
#   baseUrl : e.g. http://site.localhost:8000
#   token   : "<api_key>:<api_secret>" of a user (User -> API Access -> Generate Keys)
# Never put a real token in this file; it is committed.
#
# Requires: bench --site <site> set-config server_script_enabled true
#           bench --site <site> migrate   (creates the sample "echo" endpoint: POST only)





### 0.
POST {{baseUrl}}/api/method/loom-log
Authorization: token {{token}}
Content-Type: application/json

{
	"reading": "2233"
}


### 0. the device's poll: answers the command last sent from the Loom Dashboard
###    (script: logicx_biz.logicx_hr.loom_dashboard.COMMAND_SCRIPT), then empties it,
###    so a second call right after returns "command": ""
GET {{baseUrl}}/api/method/loom-command
Authorization: token {{token}}





### 0.
POST {{baseUrl}}/api/method/apparel-log
Authorization: token {{token}}
Content-Type: application/json

{
	"reading": "1234"
}


### 0. the device's poll: answers the command last sent from the Apparel Dashboard
###    (script: logicx_biz.logicx_hr.apparel_dashboard.COMMAND_SCRIPT), then empties it,
###    so a second call right after returns "command": ""
GET {{baseUrl}}/api/method/apparel-command
