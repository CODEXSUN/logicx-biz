{
	"doctype": "DocType",
	"name": "Job Attachment",
	"module": "LogicX HR",
	"autoname": "JOBATT.#",
	"track_changes": 1,
	"track_views": 1,
	"is_submittable": 0,
	"allow_rename": 1,
	"allow_import": 1,
	"title_field": "enquiry",
	"show_title_field_in_link": 1,
	"sort_field": "creation",
	"sort_order": "DESC",
	"index_web_pages_for_search": 1,
	"grid_page_length": 50,
	"fields": [
		{
			"label": "Enquiry",
			"fieldname": "enquiry",
			"fieldtype": "Link",
			"options": "Enquiry",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"in_filter": 1
		},
		{
			"label": "Employee",
			"fieldname": "employee",
			"fieldtype": "Link",
			"options": "Employee",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"in_filter": 1
		},
		{
			"fieldname": "column_break_1",
			"fieldtype": "Column Break"
		},
		{
			"label": "Date",
			"fieldname": "date",
			"fieldtype": "Date",
			"default": "Today",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"label": "Time",
			"fieldname": "time",
			"fieldtype": "Time",
			"default": "Now",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "section_attachment",
			"fieldtype": "Section Break"
		},
		{
			"label": "Document",
			"fieldname": "document",
			"fieldtype": "Attach",
			"reqd": 1
		},
		{
			"label": "Is Photo",
			"fieldname": "is_photo",
			"fieldtype": "Check",
			"default": "0",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "column_break_2",
			"fieldtype": "Column Break"
		},
		{
			"label": "Preview",
			"fieldname": "preview",
			"fieldtype": "Image",
			"options": "document",
			"depends_on": "eval:doc.is_photo && doc.document"
		}
	],
	"permissions": [
		{
			"if_owner": 0,
			"permlevel": 0,
			"role": "TM User",
			"read": 1,
			"create": 1,
